# Railway 운영(Production) 웹 서비스 Variables — Dashboard에 아래를 추가한 뒤 Redeploy
# (스테이징은 별도 URL·값 사용)

PUBLIC_URL=https://www.cbiseo.com
TENANT_HOST_BASE_DOMAIN=cbiseo.com
TENANT_HOST_ALIAS_DOMAINS=skcleantec.com
PLATFORM_HOST_SUBDOMAIN=platform

# 클라이언트 빌드(Docker) — 서버와 동일 값, VITE_ 접두
VITE_TENANT_HOST_BASE_DOMAIN=cbiseo.com
VITE_TENANT_HOST_ALIAS_DOMAINS=skcleantec.com
VITE_PLATFORM_HOST_SUBDOMAIN=platform

# DATABASE_URL, JWT_SECRET 등은 Railway Postgres·기존 운영 값 유지

