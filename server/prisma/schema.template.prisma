/// ë¹ ë¥¸?±ë¡ ???Œë„Œ?¸ë³„ ?™ìŠµ ê·œì¹™ (?¼ë²¨Â·?•ê·œ??
model QuickPasteTenantRule {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  fieldKey  String   @map("field_key") @db.VarChar(32)
  ruleType  String   @map("rule_type") @db.VarChar(24)
  pattern   String   @db.VarChar(512)
  sortOrder Int      @default(0) @map("sort_order")
  hitCount  Int      @default(0) @map("hit_count")
  source    String   @default("learned") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fieldKey, sortOrder])
  @@map("quick_paste_tenant_rules")
}

/// ë¹ ë¥¸?±ë¡ ??parse/commit ?™ìŠµ ë¡œê·¸
model QuickPasteLearningLog {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  userId            String?  @map("user_id")
  inquiryId         String?  @map("inquiry_id")
  textHash          String   @map("text_hash") @db.VarChar(64)
  textLength        Int      @map("text_length")
  ruleDraft         Json     @map("rule_draft")
  previewDraft      Json     @map("preview_draft")
  finalDraft        Json     @map("final_draft")
  missingAfterRule  Json     @default("[]") @map("missing_after_rule")
