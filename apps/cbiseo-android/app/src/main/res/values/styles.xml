<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CbiseoApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#121828</item>
        <item name="colorPrimaryVariant">#121828</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- edge-to-edge: Activity에서 enableEdgeToEdge() — statusBarColor/navigationBarColor 테마 attr 사용 금지 (API 35+ deprecated) -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.CbiseoApp.Splash" parent="Theme.CbiseoApp">
        <item name="android:windowBackground">@drawable/splash_window_layer</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CbiseoApp.SplashContent" parent="Theme.CbiseoApp">
        <item name="android:windowBackground">@drawable/splash_window_layer</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CbiseoApp.Onboarding" parent="Theme.CbiseoApp">
        <item name="android:windowBackground">@color/onboarding_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.Onboarding.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/onboarding_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Theme.CbiseoApp.Login" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#121828</item>
        <item name="colorPrimaryVariant">#121828</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/login_background</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
