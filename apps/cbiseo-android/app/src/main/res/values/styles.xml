<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CbiseoApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#121828</item>
        <item name="colorPrimaryVariant">#121828</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#121828</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- 앱 시작 프리뷰 — 1번 스플래시 이미지 전체 -->
    <style name="Theme.CbiseoApp.Splash" parent="Theme.CbiseoApp">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/splash_window_bg</item>
        <item name="android:navigationBarColor">@color/splash_window_bg</item>
    </style>

    <!-- 로그인 — 2번 패턴 배경 -->
    <style name="Theme.CbiseoApp.Login" parent="Theme.CbiseoApp">
        <item name="android:windowBackground">@drawable/login_background_drawable</item>
        <item name="android:statusBarColor">#B8D9F2</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
