{
  "_comment": "CBISEO agent orchestra — English display names and scopes. Updated by Maestro when agents change.",
  "_lastUpdated": "2026-09-01",
  "orchestrator": {
    "id": "maestro-orchestrator",
    "displayName": "Maestro",
    "skillPath": ".cursor/skills/maestro-orchestrator/SKILL.md",
